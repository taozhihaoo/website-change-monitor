# Server
APP_PORT=3000
DB_PATH=data/wcm.db
LOG_LEVEL=info

# Browser
BROWSER_HEADLESS=true

# Check pipeline
MAX_CONCURRENT_CHECKS=5
DEFAULT_TIMEOUT=30000
EXTRACTION_SETTLE_MS=1000

# Scheduler
SCHEDULER_TICK_MS=10000

# Webhook notifications
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_MAX_ATTEMPTS=3

# DNS-level SSRF guard (applies when ALLOW_PRIVATE_TARGETS=false)
DNS_TIMEOUT_MS=5000

# Keep at most N snapshots per monitor (0 = unlimited history)
MAX_SNAPSHOTS_PER_MONITOR=100

# SECURITY: allow monitors to target localhost / private-network URLs.
# Intended ONLY for development, testing and the offline demo against local
# fixture pages. Never enable this in a deployment you do not fully control.
ALLOW_PRIVATE_TARGETS=false

# Provider used when a monitor has no webhook configured: none | mock
DEFAULT_NOTIFICATION_PROVIDER=none
