{
  "name": "website-change-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small, self-hosted website change monitoring service: Playwright extraction, SQLite history, scheduled checks and webhook notifications.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm run dev -w client",
    "build": "tsc -p tsconfig.build.json && npm run build -w client",
    "start": "node dist/index.js",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck -w client",
    "check": "npm run lint && npm run typecheck && npm run test",
    "demo": "tsx scripts/demo.ts",
    "serve:fixture": "node scripts/fixture-server.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "better-sqlite3": "^12.2.0",
    "diff": "^7.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.3.0",
    "pino": "^9.7.0",
    "playwright": "^1.54.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/diff": "^7.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
